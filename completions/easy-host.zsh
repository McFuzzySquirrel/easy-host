#compdef easy-host
# easy-host zsh completion
#
# Generated by scripts/generate-completions.ts from the commander command
# definitions. Do not edit this file by hand; regenerate it instead.
#
# Install: copy this file to a directory on $fpath, for example
#   ${XDG_DATA_HOME:-$HOME/.local/share}/zsh/site-functions/_easy-host
# and run compinit.

_easy_host() {
  local -a _easy_host_commands
  _easy_host_commands=(
    'add:Add an app from a git repository or local path'
    'list:List registered apps'
    'status:Show app status and drift'
    'logs:Stream an app'\''s container logs'
    'update:Rebuild or recreate an app'
    'rollback:Swap an app back to its previous image'
    'remove:Remove an app and its resources'
    'config:Show or edit an app'\''s configuration'
    'doctor:Check host prerequisites'
    'version:Print the easy-host version'
  )

  local cmd=""
  local i

  for (( i = 2; i < CURRENT; i++ )); do
    case "${words[i]}" in
      add|list|status|logs|update|rollback|remove|config|doctor|version)
        cmd="${words[i]}"
        break
        ;;
    esac
  done

  if [[ -z "$cmd" ]]; then
    _arguments -s \
      '--json[write one machine-readable JSON document to stdout]' \
      '(-h --help)'{-h,--help}'[display help for command]'
    _describe -t commands 'easy-host command' _easy_host_commands
    return
  fi

  case "$cmd" in
    add)
      _arguments -s \
        '--local[add from a local workspace path instead of a git URL]:path:_files' \
        '--name[app name (defaults to the repository name)]:app:' \
        '--ref[git ref to build (branch, tag, or commit)]:ref:' \
        '--port[host port to publish]:port:' \
        '--container-port[container port the app listens on]:port:' \
        '--bind[address to bind the published port to]:addr:' \
        '--env-file[environment file for the app]:path:_files' \
        '--health-path[HTTP path used by the readiness probe]:path:' \
        '--probe[probe type used for readiness]:http|tcp:(http tcp)' \
        '--volume[named volume to mount (repeatable)]:name\:container-path:' \
        '--yes[accept prompts without asking]' \
        '--json[write one machine-readable JSON document to stdout]' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1::git-url:'
      ;;
    list)
      _arguments -s \
        '--json[write one machine-readable JSON document to stdout]' \
        '(-h --help)'{-h,--help}'[display help for command]'
      ;;
    status)
      _arguments -s \
        '--json[write one machine-readable JSON document to stdout]' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1::app:'
      ;;
    logs)
      _arguments -s \
        '(-f --follow)'{-f,--follow}'[follow log output]' \
        '--tail[number of lines to show before following]:n:' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1:app:'
      ;;
    update)
      _arguments -s \
        '--rebuild[force a rebuild even when the ref is unchanged]' \
        '--json[write one machine-readable JSON document to stdout]' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1:app:'
      ;;
    rollback)
      _arguments -s \
        '--json[write one machine-readable JSON document to stdout]' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1:app:'
      ;;
    remove)
      _arguments -s \
        '--volumes[also delete the app'\''s named volumes]' \
        '--yes[confirm non-interactively]' \
        '--force[remove without confirmation prompts]' \
        '--json[write one machine-readable JSON document to stdout]' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1:app:'
      ;;
    config)
      _arguments -s \
        '--path[print the app'\''s directory path]' \
        '--edit[open the app'\''s configuration in $EDITOR]' \
        '--json[write one machine-readable JSON document to stdout]' \
        '(-h --help)'{-h,--help}'[display help for command]' \
        '1:app:'
      ;;
    doctor)
      _arguments -s \
        '--json[write one machine-readable JSON document to stdout]' \
        '(-h --help)'{-h,--help}'[display help for command]'
      ;;
    version)
      _arguments -s \
        '--json[write one machine-readable JSON document to stdout]' \
        '(-h --help)'{-h,--help}'[display help for command]'
      ;;
  esac
}

if [[ "$funcstack[1]" == "_easy_host" ]]; then
  _easy_host "$@"
fi
