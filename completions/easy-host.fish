# easy-host fish completion
#
# Generated by scripts/generate-completions.ts from the commander command
# definitions. Do not edit this file by hand; regenerate it instead.
#
# Install: copy this file to
#   ${XDG_CONFIG_HOME:-$HOME/.config}/fish/completions/easy-host.fish

complete -c easy-host -f
complete -c easy-host -n '__fish_use_subcommand' -l json -d 'write one machine-readable JSON document to stdout'
complete -c easy-host -s h -l help -d 'display help for command'

complete -c easy-host -n '__fish_use_subcommand' -a add -d 'Add an app from a git repository or local path'
complete -c easy-host -n '__fish_use_subcommand' -a list -d 'List registered apps'
complete -c easy-host -n '__fish_use_subcommand' -a status -d 'Show app status and drift'
complete -c easy-host -n '__fish_use_subcommand' -a logs -d 'Stream an app\'s container logs'
complete -c easy-host -n '__fish_use_subcommand' -a update -d 'Rebuild or recreate an app'
complete -c easy-host -n '__fish_use_subcommand' -a rollback -d 'Swap an app back to its previous image'
complete -c easy-host -n '__fish_use_subcommand' -a remove -d 'Remove an app and its resources'
complete -c easy-host -n '__fish_use_subcommand' -a config -d 'Show or edit an app\'s configuration'
complete -c easy-host -n '__fish_use_subcommand' -a doctor -d 'Check host prerequisites'
complete -c easy-host -n '__fish_use_subcommand' -a version -d 'Print the easy-host version'

# add
complete -c easy-host -n '__fish_seen_subcommand_from add' -l local -r -F -d 'add from a local workspace path instead of a git URL'
