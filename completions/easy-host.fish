complete -c easy-host -n '__fish_seen_subcommand_from add' -l port -r -d 'host port to publish'
complete -c easy-host -n '__fish_seen_subcommand_from add' -l container-port -r -d 'container port the app listens on'
complete -c easy-host -n '__fish_seen_subcommand_from add' -l bind -r -d 'address to bind the published port to'
complete -c easy-host -n '__fish_seen_subcommand_from add' -l env-file -r -F -d 'environment file for the app'
complete -c easy-host -n '__fish_seen_subcommand_from add' -l health-path -r -d 'HTTP path used by the readiness probe'
complete -c easy-host -n '__fish_seen_subcommand_from add' -l probe -r -x -a 'http tcp' -d 'probe type used for readiness'
complete -c easy-host -n '__fish_seen_subcommand_from add' -l volume -r -d 'named volume to mount (repeatable)'
complete -c easy-host -n '__fish_seen_subcommand_from add' -l yes -d 'accept prompts without asking'
complete -c easy-host -n '__fish_seen_subcommand_from add' -l json -d 'write one machine-readable JSON document to stdout'

# list
complete -c easy-host -n '__fish_seen_subcommand_from list' -l json -d 'write one machine-readable JSON document to stdout'

# status
complete -c easy-host -n '__fish_seen_subcommand_from status' -l json -d 'write one machine-readable JSON document to stdout'

# logs
complete -c easy-host -n '__fish_seen_subcommand_from logs' -s f -l follow -d 'follow log output'
complete -c easy-host -n '__fish_seen_subcommand_from logs' -l tail -r -d 'number of lines to show before following'

# update
complete -c easy-host -n '__fish_seen_subcommand_from update' -l rebuild -d 'force a rebuild even when the ref is unchanged'
complete -c easy-host -n '__fish_seen_subcommand_from update' -l json -d 'write one machine-readable JSON document to stdout'

