[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z   write(chunk: string): unknown;
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z }
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z export interface DoctorCommandOptions extends DoctorOptions {
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z   /** Writes the JSON document instead of the human report. */
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z   json?: boolean;
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z   /** Destination for the report. Defaults to `process.stdout`. */
