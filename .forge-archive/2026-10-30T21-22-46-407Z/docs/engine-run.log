[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z   return report.status === "fail" ? EXIT_CODES.PREREQUISITE : EXIT_CODES.SUCCESS;
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z }
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z /**
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z  * Runs doctor, writes exactly one report to stdout, and returns the exit code
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z  * the top-level entry should use.
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z  */
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z export function runDoctorCommand(options: DoctorCommandOptions = {}): ExitCode {
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z   const { json = false, stdout = process.stdout, ...doctorOptions } = options;
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z   const report = runDoctor(doctorOptions);
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z   stdout.write(json ? formatDoctorJson(report) : formatDoctorReport(report));
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z   return doctorExitCode(report);
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:05.511Z }
