[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z import { createDefaultPodmanRunner, type PodmanRunner } from "./podman.js";
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z /**
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * Rootless reboot recovery.
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  *
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * `--restart=always` is a *supervisor* policy: it is enforced by the
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * podman/conmon process that is already alive, and it is not a boot-time hook.
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * For a rootless user nothing is alive after a reboot until systemd starts the
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * user manager, and even then no container is started unless something replays
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * the restart policy. Lingering only starts the user manager.
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  *
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * Podman ships `podman-restart.service`, a systemd *user* unit that runs
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * `podman start --all --filter restart-policy=always` at `default.target`. It is
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * not enabled by default, so `add` enables it. Enabling a user unit needs no
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  * root, and it is idempotent.
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z  */
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z export const PODMAN_RESTART_SERVICE = "podman-restart.service";
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z /** The systemd client binary; user units are reached through `systemctl --user`. */
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z const SYSTEMCTL_BINARY = "systemctl";
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z /** Finite timeout so `add` can never block on a wedged user manager (`PRD-NF-05`). */
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z const BOOT_RECOVERY_TIMEOUT_MS = 15_000;
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z /** Outcome of asking systemd to enable the podman restart unit. */
[engine] harness activity stderr task=DOC-1.4 attempt=2 at=2026-10-30T20:48:07.737Z export interface BootRecoveryResult {
